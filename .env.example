# NVIDIA API (OpenAI-compatible) for the LLM and embeddings
NVIDIA_API_KEY=
# Optional: switch model (default poolside/laguna-xs-2.1)
# DP_MODEL=google/gemma-4-31b-it
# HydraDB over Bolt. Local node from `make hydradb` (unset = embedded Kuzu)
HYDRADB_URI=bolt://127.0.0.1:7687
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_DATABASE=
